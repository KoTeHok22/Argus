# Не тащим в контекст сборки ничего лишнего.
# Особенно — датасет: он конфиденциален и весит гигабайты.

# Конфиденциальное и тяжёлое
data/
датасет/
data/
*.zst
*.db3
*.pcd
*.npz
results/

# Артефакты сборки
build/
install/
log/
.deps/
__pycache__/
*.pyc
.pytest_cache/

# Третьи стороны (подтягиваются внутри образа через vcs import)
third_party/*/

# Git и инструменты
.git/
.gitignore
.github/
.repowise/
.vscode/
.idea/

# Документация не нужна в рантайме
docs/img/
*.mp4
