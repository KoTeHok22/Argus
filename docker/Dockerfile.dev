FROM osrf/ros:humble-desktop-full-jammy

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git wget curl \
    python3-pip python3-colcon-common-extensions python3-vcstool \
    python3-rosdep python3-argcomplete \
    libeigen3-dev libboost-all-dev libyaml-cpp-dev \
    libpcl-dev pcl-tools \
    libpcap-dev libtbb-dev liblz4-dev \
    clang-format clang-tidy gdb valgrind tar zstd \
    && rm -rf /var/lib/apt/lists/*

RUN rosdep init || true && rosdep update

RUN pip3 install --no-cache-dir \
    numpy scipy matplotlib pandas open3d rerun-sdk zstandard

WORKDIR /ws
SHELL ["/bin/bash", "-c"]
