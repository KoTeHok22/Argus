<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>argus_launch</name>
  <version>0.1.0</version>
  <description>Запуск конвейера Argus: launch-файлы, RViz2-конфиг, профили</description>
  <maintainer email="dev@example.com">Argus team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>argus_node_preprocess</exec_depend>
  <exec_depend>argus_node_odometry</exec_depend>
  <exec_depend>argus_node_tunnel_model</exec_depend>
  <exec_depend>argus_node_detector</exec_depend>
  <exec_depend>argus_node_fusion</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
