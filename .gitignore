# Argus — правила исключения (продакшн)
#
# Во время разработки в репозиторий кладём всё содержательное: скрипты разведки,
# метаданные бэгов, отчёты, дампы кадров — данные важны на всех машинах.
# Игнорируем только то, что физически не влезает в GitHub или является мусором.

# --- Бинарные данные, несовместимые с GitHub (>100 МБ на файл) ---
*.db3
*.db3-wal
*.db3-shm
*.mcap
*.bag
*.zst
*.head
*.frames

data/ui/
data/new_data_full/
results/t32_new_data/

# --- Артефакты сборки ROS 2 ---
build/
install/
log/
.deps/
compile_commands.json

# --- Артефакты сборки C++ ---
*.o
*.so
*.a
*.dylib
*.dll
*.exe
*.out
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
CTestTestfile.cmake

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
.conda/

# --- Третьи стороны (подтягиваются через vcs import) ---
third_party/*/
!third_party/argus.repos

# --- Инструменты и редакторы ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Секреты ---
.env
.env.*
*.pem
*.key
secrets.yaml

# --- Индексы инструментов ---
.repowise/
.tmp_comment_cleanup/
AGENTS.md

*.md
!/README.md
!docs/EXPERIMENTS.md

# --- Данные, макеты и артефакты прогонов: вне репозитория ---
data/
design/
results/
third_party/patchworkpp/
docs/img/
docs/video/
ProjectSubmission/

# --- Скриншоты и служебные файлы инструментов ---
*.png
.kilo/
.mcp.json
codex_settings.json

